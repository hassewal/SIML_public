x = ~beta1, y = ~beta2, z = ~z
) %>% add_surface(opacity = 0.8)
t <- 1  # radius of the diamond
b1 <- seq(-t, t, length.out = 200)
b2_upper <- t - abs(b1)
b2_lower <- -t + abs(b1)
z_val <- 1.5 # z height of constraint.
p <- p %>%
add_trace(x = b1, y = b2_upper, z = z_val, type="scatter3d", mode="lines", line=list(color="red", width=5)) %>%
add_trace(x = b1, y = b2_lower, z = z_val, type="scatter3d", mode="lines", line=list(color="red", width=5)) %>%
add_trace(x = c(-t,-t), y = c(0,0), z = c(z_val,z_val), type="scatter3d", mode="markers", marker=list(size=1, color="red")) %>%
add_trace(x = -2, y = 1, z = 0, type="scatter3d", mode="markers",
marker=list(size=4, color="red", symbol="circle"),
name="OLS minimum")
p
sqrt(0.1)
sqrt(0.9)
sqrt(0.7)
51.5-14.5
# libraries
library(rstan); library(ggplot2); library(ggpubr);library(dplyr)
version
## DATA
## Load data
setwd("C:/Users/hanwa473/Desktop/undervisning/SIML_public")
train_data <- read_csv("A3_train_data.csv", show_col_types = F)
library(tidyverse)
library(caret)
library(psych)
library(ggplot2)
library(ggpubr)
## DATA
## Load data
setwd("C:/Users/hanwa473/Desktop/undervisning/SIML_public")
train_data <- read_csv("A3_train_data.csv", show_col_types = F)
test_data <- read_csv("A3_test_data.csv", show_col_types = F)
# check variable types
#  last year "tempo" was not numeric, it had "?" in many places. I removed and knn-imputed those, so now its fine.
str(train_data)
# Select dependent variable
prediction_genres <- c("Country", "Jazz")
## Clean data, remove irrelevant variables
train_data <- train_data %>% select(!(instance_id))  %>% select(!(artist_name)) %>% select(!(track_name))
test_data <- test_data %>% select(!(instance_id))  %>% select(!(artist_name)) %>% select(!(track_name))
train_data
# Select the two genres
train_data <- train_data %>% filter(music_genre %in% prediction_genres)
test_data <- test_data %>% filter(music_genre %in% prediction_genres)
train_data
test_data
# these two should be included
must_include <- c("tempo","danceability")
# then add some other arbitrarily
covariates <- c(must_include, "key", "energy", "instrumentalness") # Or some other combination
# You can theoretically use everything but the names, the index and 'music_genre'
all_variables <- c(covariates, "music_genre")
train_data <- train_data %>% select(all_of(all_variables))
test_data <- test_data %>% select(all_of(all_variables))
train_data
test_data
str(train_data) #all are numeric, good
## TRAIN
## Partition data into train/test
set.seed(131)
## KNN
# Linear grid for KNN, needs to be whole numbers so we use 'floor'
knn_grid <- floor(seq(1, 100, length = 50))
knn_grid
model_knn <- train(
music_genre ~., data = train_data, method = "knn",
trControl = trainControl(method = "LGOCV", number = 1, p=0.7),
preProcess = c("center","scale"),
tuneGrid = expand.grid(k=knn_grid),
metric = "Accuracy"
)
model_knn
## SVM with radial basis function
model_svm <- train(
music_genre ~., data = train_data, method = "svmRadial",
trControl = trainControl(method = "LGOCV", number = 1, p=0.7),
tuneGrid = expand.grid(C = 10^seq(-2, 4, length = 50), sigma = 0.05),
preProcess = c("center","scale"),
metric = "Accuracy"
)
model_svm
## EVALUATION
## Evaluate on the test set
model <- model_svm # select which model to evaluate
## EVALUATION
## Evaluate on the test set
model <- model_svm # select which model to evaluate
predicted <- predict(model, test_data)
predicted
y_hat <- ifelse(predicted == prediction_genres[1], 1, -1)
y_true <- ifelse(test_data$music_genre == prediction_genres[1], 1, -1)
# Accuracy
accuracy <- mean(y_hat == y_true)
mean(-1 == y_true)
prediction_genres[2]
accuracy_baseline <- max(mean(1 == y_true), mean(-1 == y_true)) # Predict majority class
accuracy
accuracy_baseline
# Confusion matrix; f-score
confusionMatrix(predicted, as.factor(test_data$music_genre), mode = "everything", positive= prediction_genres[1])
# Cohen's kappa
mean(y_true == y_hat)
x <- matrix(data = c(y_hat, y_true), nrow = length(y_hat), ncol = 2)
cohen.kappa(x)
# If model is SVM
p1 <- model_svm$results  %>%
ggplot(aes(log(C), Accuracy)) +
geom_line(color="#66c2a5", size=1) + geom_hline(yintercept=accuracy_baseline, color="#fc8d62", linewidth=1)# +
# If model is SVM
p1 <- model_svm$results  %>%
ggplot(aes(log(C), Accuracy)) +
geom_line(color="#66c2a5", linewidth=1) + geom_hline(yintercept=accuracy_baseline, color="#fc8d62", linewidth=1)# +
#ylim(0.775, 0.875)
p1
# If model is KNN
p2 <- model_knn$results  %>%
ggplot(aes(k, Accuracy)) +
geom_line(color="#66c2a5", size=1) + geom_hline(yintercept=accuracy_baseline, color="#fc8d62", linewidth=1)
p2
ggarrange(p1,p2)
