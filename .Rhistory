##########################################################
####### 1. Load, plot and preprocess data  ###############
## Load CSV from github
nhl <- read.csv('https://raw.githubusercontent.com/ninpnin/nhl-ennustus/main/data/202324.csv')
nhl
## Change colname +/- for convenience
colnames(nhl)[10] ="PLUSMINUS"
# good to check variable types
str(nhl)
# take a subset of variables with not too much "data leakage"
nhl <- nhl %>% dplyr::select(PTS,Age,GP,PLUSMINUS,SOG)
# variable explanations: https://www.milehighhockey.com/pages/stats
# Check for missing values
apply(nhl, 2, function(x) sum(is.na(x)))
## Plot some of the features
## Plot PTS,
ggplot(nhl, aes(x=PTS)) +
geom_histogram(aes(y=..density..),
binwidth=2.5,
colour="black", fill="white") +
geom_density(alpha=.2, fill="#FF6666")
## Plot +/-,
ggplot(nhl, aes(x=PLUSMINUS)) +
geom_histogram(aes(y=..density..),
binwidth=1,
colour="black", fill="white") +
geom_density(alpha=.2, fill="#FF6666")
## Plot age,
ggplot(nhl, aes(x=Age)) +
geom_histogram(aes(y=..density..),
binwidth=1,
colour="black", fill="white") +
geom_density(alpha=.2, fill="#FF6666")
######## Keep only numeric columns
nhl <- nhl %>% dplyr::select(where(is.numeric)) # can be done in base R somehow
str(nhl) #looks ok
# check the correlation matrix
nhl_corr <- cor(nhl)
corrplot(nhl_corr)
##############################################################
################### 2.  Now ready to fit some models ##########
# Select target variable
target_variable <- "PTS" #
# rename target to "y"
names(nhl)[names(nhl) == target_variable] <- "y"
################# Train and test split ######################
# Create a test set that we hold out for the final evaluation
# set seed if you want reproducible results
set.seed(666)
# shuffle rows to be on the safe side
nhl <- nhl[sample(nrow(nhl)),]
# create train and test split
training_samples <- caret::createDataPartition(nhl$y, p=0.8, list=FALSE)
train_data <- nhl[training_samples,]
test_data <- nhl[-training_samples,]
# store response separately so that we do not scale it
y_train <- train_data[,c("y")]
train_data_scaled <- as.data.frame(scale(train_data))
train_data_scaled$y <- y_train # attach the non-scaled response
# if scaling correct, mean should be zero and variance one.
mean(train_data_scaled$Age)
var(train_data_scaled$Age)
svm_radial <- caret::train(
y ~ .,
data = train_data,
method = 'svmRadial',
preProcess = c("center","scale"), # normalize
trControl = trainControl("repeatedcv", number = 10, repeats=1), # "LOOCV" for leave-one-out CV.
tuneGrid = expand.grid(sigma = c(0.00003, 0.0003, 0.003, 0.03, 0.3, 3), C = c( 1, 5, 10, 20, 50, 100, 200))
)
svm_radial
predictions <- predict(svm_radial, test_data)
sqrt( mean((predictions - test_data$y)^2) )
# check visually
df_plot <- data.frame(true = test_data$y, predicted = predictions)
ggplot(df_plot, aes(x = true, y = predicted)) +
geom_point() +
geom_abline(slope = 1, intercept = 0, color = "red")
## Grid search over RBK parameters sigma, C; train-validation split (validation set approach)
