test_old <- read.csv("A03_genres_test.csv", header = T, sep=",")
colSums(is.na(train_old)) # no missing values
str(test_old)
# combine to manipulate "tempo", which has "?" as entries
df <- bind_rows(train_old,test_old)
df$tempo <- as.numeric(df$tempo) # NAs were introduced
df <- kNN(df, k = 3)
df <- df[1:ncol(train_old)] #remove added cols
