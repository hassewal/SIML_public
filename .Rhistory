preProcess = c("center","scale"), # normalize
trControl = trainControl(method = "LGOCV", number = 1, p=0.7),
tuneGrid = expand.grid(sigma = c(0.00003, 0.0003, 0.003, 0.03, 0.3, 3), C = c(0.1, 0.25, 0.5, 1, 5, 10, 20, 50, 100, 150))
)
svm_radial
## Evaluation
predictions <- predict(svm_radial, test_data)
predictions
sqrt( mean((predictions - test_data$y)^2) )
# Baseline check: what if we used the mean as predictions for every observation?
sqrt(mean((mean(test_data$y) - test_data$y)^2))
