# 3. Ridge regression
lambda <- 10^seq(-2, 1, length = 100)
plot(lambda, rep(1, length(lambda)), pch=16, col="black",
xlab="lambda", ylab="", yaxt="n", main="Lambda grid on real line")
ridge_or_lasso <- train(
y ~., data = train_data, method = "glmnet",
trControl = trainControl("repeatedcv", number = 10, repeats = 1),
tuneGrid = expand.grid(alpha = 0, lambda = lambda), # ridge since alpha is zero
preProcess = c("center","scale")
)
ridge_or_lasso <- caret::train(
y ~., data = train_data, method = "glmnet",
trControl = trainControl("repeatedcv", number = 10, repeats = 1),
tuneGrid = expand.grid(alpha = 0, lambda = lambda), # ridge since alpha is zero
preProcess = c("center","scale")
)
ridge_or_lasso
# Evaluate
predictions <- predict(ridge_or_lasso, test_data)
sqrt( mean((predictions - test_data$y)^2) )
# Check coefficients
best_lambda <- ridge_or_lasso$bestTune$lambda
best_coef <- coef(ridge_or_lasso$finalModel,best_lambda)
best_coef
# coefficient trajectory plot
plot(ridge_or_lasso$finalModel, xvar = "lambda", label = F)
ridge_or_lasso <- caret::train(
y ~., data = train_data, method = "glmnet",
trControl = trainControl("repeatedcv", number = 10, repeats = 1),
tuneGrid = expand.grid(alpha = 1, lambda = lambda), # ridge since alpha is zero
preProcess = c("center","scale")
)
ridge_or_lasso
# Evaluate
predictions <- predict(ridge_or_lasso, test_data)
sqrt( mean((predictions - test_data$y)^2) )
# Check coefficients
best_lambda <- ridge_or_lasso$bestTune$lambda
best_coef <- coef(ridge_or_lasso$finalModel,best_lambda)
best_coef
# coefficient trajectory plot
plot(ridge_or_lasso$finalModel, xvar = "lambda", label = F)
log(0.04037017)
# Finally. Elastic net
lambda <- 10^seq(-2, 1, length = 100)
alpha <- seq(0, 1.0, length = 20)
e.net <- train(
y ~., data = train_data, method = "glmnet",
trControl = trainControl("repeatedcv", number = 10, repeats = 1),
tuneGrid = expand.grid(alpha = alpha, lambda = lambda),
preProcess=c("center","scale")
)
# Finally. Elastic net
lambda <- 10^seq(-2, 1, length = 100)
alpha <- seq(0, 1.0, length = 20)
e.net <- caret::train(
y ~., data = train_data, method = "glmnet",
trControl = trainControl("repeatedcv", number = 10, repeats = 1),
tuneGrid = expand.grid(alpha = alpha, lambda = lambda),
preProcess=c("center","scale")
)
# Evaluate elastic net
predictions <- predict(e.net, test_data)
sqrt( mean((predictions - test_data$y)^2) )
# Check hyperparameters
e.net$bestTune
# Check coefficients
best_lambda <- e.net$bestTune$lambda
coef(e.net$finalModel,best_lambda)
# coefficient trajectory plot
plot(e.net$finalModel, xvar = "lambda", label = F) # looks like mix of lasso and ridge
### Extra, just how to do K Nearest Neighbours
knn <- train(
y ~ .,
data = train_data,
method = 'knn',
trControl = trainControl(method = "LGOCV", number = 1, p=0.7),
tuneGrid = expand.grid(k=seq(1,200)),
preProcess = c("center","scale")
)
